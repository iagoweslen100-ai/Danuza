# ----------------------------------------------------------------------
# Configuração para Hospedagem cPanel / Apache / LiteSpeed
# Site: Danuza Thiali Personal Trainer
# ----------------------------------------------------------------------

# Ativar motor de reescrita
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Se o arquivo ou diretório físico existir, entrega diretamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Se existir uma pasta com index.html correspondente à rota (ex: /sobre -> /sobre/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 3. Fallback de SPA: qualquer outra rota direciona para o index.html principal
  RewriteRule ^ index.html [L]
</IfModule>

# Forçar charset UTF-8
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js .xml .json .svg
</IfModule>

# Ativar Compressão GZIP / Deflate para carregamento ultrarrápido
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# Cache de Navegador (Assets têm hash no nome, então podem ficar 1 ano em cache)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML não deve ter cache longo para garantir atualizações imediatas
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript e Fontes
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # Imagens
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# Segurança básica de cabeçalhos
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
